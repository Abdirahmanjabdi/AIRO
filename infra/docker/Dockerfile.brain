# =============================================================================
# Sentinel Brain API — Production Dockerfile
# Multi-stage build, Python 3.12, non-root user
# =============================================================================

# --- Stage 1: Builder ---
FROM python:3.12-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY pyproject.toml ./
COPY src/ ./src/

RUN pip wheel --no-cache-dir --wheel-dir /build/wheels .

# --- Stage 2: Runtime ---
FROM python:3.12-slim AS runtime

RUN groupadd -r sentinel && useradd -r -g sentinel -m sentinel

WORKDIR /app

COPY --from=builder /build/wheels /tmp/wheels
RUN pip install --no-cache-dir /tmp/wheels/*.whl && rm -rf /tmp/wheels

COPY src/ ./src/
COPY alembic/ ./alembic/
COPY alembic.ini ./
COPY infra/docker/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

RUN mkdir -p /app/data && chown -R sentinel:sentinel /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SENTINEL_MODEL_PATH=/app/default_model.joblib \
    ANYIO_MAX_THREADS=50

USER sentinel

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c 'import httpx; r = httpx.get("http://localhost:8000/healthz"); exit(0 if r.status_code == 200 else 1)'

ENTRYPOINT ["./entrypoint.sh"]
