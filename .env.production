# =============================================================================
# Sentinel Trading — Production Environment Variables
# Copy to .env and fill in all values before running docker-compose
# =============================================================================

# --- Core Security (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_SECRET_KEY=CHANGE_ME_generate_a_strong_secret_key_here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SENTINEL_ENCRYPTION_KEY=CHANGE_ME_generate_fernet_key_here

# Optional: Fernet key for Vault fallback credential encryption (when Vault is not deployed)
# Generate same way as SENTINEL_ENCRYPTION_KEY
SENTINEL_FALLBACK_VAULT_KEY=CHANGE_ME_generate_another_fernet_key_here

# --- CORS (REQUIRED) ---
# Your EC2 public IP or domain. No trailing slash.
# Example: http://54.123.45.67 or https://sentinel.yourdomain.com
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# --- Public URL (REQUIRED for onboarding callbacks) ---
# Same as CORS_ORIGINS — the URL the MT5 bridge uses to call back to the Brain API
PUBLIC_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP

# --- PostgreSQL ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=sentinel

# --- MinIO (S3-compatible object store for ML models) ---
MINIO_ROOT_USER=sentinel-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
S3_BUCKET=sentinel-models

# --- Vault (optional — leave empty to use encrypted SQLite fallback) ---
SENTINEL_REQUIRE_VAULT=false
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# --- Feature Flags ---
SENTINEL_ENABLE_DOCS=false
SENTINEL_ENABLE_DATA_LAKE_EXPORT=true
SENTINEL_AUTH_DISABLED=false

# --- Port ---
SENTINEL_PORT=80

# --- AWS Region (for S3 bucket creation) ---
AWS_DEFAULT_REGION=us-east-1
